# Hostfile del clúster MPI (sección V).
# Reemplazar con las IPs reales que el router asigne a cada máquina (192.168.1.X).
#
#   slots      = núcleos lógicos que ese nodo aporta al cómputo.
#   max_slots  = tope físico; evita el oversubscribe (más procesos que núcleos),
#                que en DES dispara el overhead por cambio de contexto.
#
# Ejemplo (cambiar IPs y slots según el hardware de cada quien):

192.168.1.10 slots=4 max_slots=4   # Nodo Maestro
192.168.1.11 slots=8 max_slots=8   # Worker 1
192.168.1.12 slots=4 max_slots=4   # Worker 2
