// Tarea 2 — Diagrama de flujo del algoritmo DES
// Render: dot -Tpng -Gdpi=200 des_flujo.dot -o des_flujo.png && dot -Tsvg des_flujo.dot -o des_flujo.svg
digraph DES {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.35, newrank=true,
         label="Algoritmo DES (cifrado de un bloque de 64 bits)", labelloc=t, fontsize=16];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#3b5b92"];
  edge  [fontname="Helvetica", fontsize=10, color="#3b5b92"];

  // ---------------- Flujo principal ----------------
  subgraph cluster_main {
    label="Flujo principal"; color="#3b5b92"; style=rounded;
    inicio   [label="Inicio", shape=oval, fillcolor="#d7e4f7"];
    entrada  [label="Entrada:\nbloque de texto plano (64 bits)\nllave (64 bits)", shape=parallelogram];
    ip       [label="Permutación inicial (IP)"];
    split    [label="Dividir en L0 y R0\n(32 bits cada una)"];
    init_i   [label="i = 1"];
    ronda    [label="Ronda de Feistel i\nLi = R(i-1)\nRi = L(i-1) XOR f(R(i-1), Ki)", fillcolor="#fff4d6", color="#b08400"];
    cond     [label="¿i = 16?", shape=diamond, fillcolor="#fde2e2", color="#a33"];
    inc      [label="i = i + 1"];
    swap     [label="Intercambio final:\nR16 ‖ L16"];
    ipinv    [label="Permutación final (IP⁻¹)"];
    salida   [label="Salida:\nbloque cifrado (64 bits)", shape=parallelogram];
    fin      [label="Fin", shape=oval, fillcolor="#d7e4f7"];

    inicio -> entrada -> ip -> split -> init_i -> ronda -> cond;
    cond -> inc   [label=" No"];
    inc  -> ronda;
    cond -> swap  [label=" Sí"];
    swap -> ipinv -> salida -> fin;
  }

  // ---------------- Generación de subllaves ----------------
  subgraph cluster_keys {
    label="Generación de subllaves (key schedule)"; color="#2e7d4f"; style=rounded;
    node [fillcolor="#e6f4ea", color="#2e7d4f"];
    pc1   [label="PC-1: quitar 8 bits de paridad\ny permutar → 56 bits"];
    cd    [label="Dividir en C0 y D0\n(28 bits cada una)"];
    rot   [label="Rotar Ci y Di a la izquierda\n1 bit (rondas 1, 2, 9, 16)\n2 bits (resto)"];
    pc2   [label="PC-2: seleccionar 48 bits\n→ subllave Ki"];
    pc1 -> cd -> rot -> pc2;
    pc2 -> rot [label=" siguiente ronda", style=dashed];
  }

  // ---------------- Función f ----------------
  subgraph cluster_f {
    label="Función de ronda f(R, Ki)"; color="#b08400"; style=rounded;
    node [fillcolor="#fff4d6", color="#b08400"];
    fexp  [label="Expansión E:\nR (32 bits) → 48 bits"];
    fxor  [label="XOR con subllave Ki\n(48 bits)"];
    fsbox [label="8 cajas S (S1…S8):\n6 bits → 4 bits c/u\n→ 32 bits (no lineal)"];
    fp    [label="Permutación P\n→ f(R, Ki) (32 bits)"];
    fexp -> fxor -> fsbox -> fp;
  }

  // ---------------- Conexiones entre bloques ----------------
  entrada -> pc1   [label=" llave", style=dashed, color="#2e7d4f", fontcolor="#2e7d4f"];
  pc2     -> fxor  [label=" Ki", style=dashed, color="#2e7d4f", fontcolor="#2e7d4f"];
  ronda   -> fexp  [taillabel="R(i-1)", labeldistance=4, labelangle=20, style=dashed, color="#b08400", fontcolor="#b08400", constraint=false];
  fp      -> ronda [label=" f(R(i-1), Ki)", style=dashed, color="#b08400", fontcolor="#b08400", constraint=false];

  // ---------------- Nota sobre descifrado ----------------
  nota [shape=note, fillcolor="#f3f3f3", color="#777",
        label="Descifrado: mismo flujo aplicado al bloque cifrado,\nusando las subllaves en orden inverso (K16 … K1)."];
  fin -> nota [style=invis];
}
