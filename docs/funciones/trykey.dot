// Tarea 5.2 — tryKey(key, *ciph, len) de bruteforce.c
// Render: dot -Tpng -Gdpi=200 trykey.dot -o trykey.png && dot -Tsvg trykey.dot -o trykey.svg
digraph TryKey {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.4, ranksep=0.35, newrank=true,
         label="tryKey(key, *ciph, len)", labelloc=t, fontsize=16];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#3b5b92"];
  edge  [fontname="Helvetica", fontsize=10, color="#3b5b92"];

  subgraph cluster_main {
    label="Flujo"; color="#3b5b92"; style=rounded;
    inicio  [label="Inicio", shape=oval, fillcolor="#d7e4f7"];
    entrada [label="Entrada:\nkey (llave candidata)\nciph (texto cifrado)\nlen (bytes)", shape=parallelogram];
    temp    [label="char temp[len+1]\n(arreglo local en la pila)"];
    cpy     [label="memcpy(temp, ciph, len)\ncopia el cifrado para no destruir el original", fillcolor="#fff4d6", color="#b08400"];
    term    [label="temp[len] = 0\n(terminador para tratarlo como string)"];
    dec     [label="decrypt(key, temp, len)\ndescifra temp en su lugar", fillcolor="#e6f4ea", color="#2e7d4f"];
    sstr    [label="strstr(temp, search)\nbusca la frase clave", fillcolor="#fff4d6", color="#b08400"];
    cond    [label="¿resultado != NULL?", shape=diamond, fillcolor="#fde2e2", color="#a33"];
    si      [label="return 1\n(key es la llave correcta)", shape=parallelogram, fillcolor="#e6f4ea", color="#2e7d4f"];
    no      [label="return 0\n(texto basura, probar otra llave)", shape=parallelogram, fillcolor="#fde2e2", color="#a33"];
    fin     [label="Fin", shape=oval, fillcolor="#d7e4f7"];

    inicio -> entrada -> temp -> cpy -> term -> dec -> sstr -> cond;
    cond -> si [label=" Sí"];
    cond -> no [label=" No"];
    si -> fin; no -> fin;
  }

  mem [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff">
      <tr><td colspan="5" bgcolor="#e6f4ea"><b>Memoria durante un intento</b></td></tr>
      <tr><td><b>ciph</b></td><td>4b cb 99 ac</td><td>94 52 16 c4</td><td>…</td><td>(no se modifica)</td></tr>
      <tr><td><b>temp</b> tras memcpy</td><td>4b cb 99 ac</td><td>94 52 16 c4</td><td>…</td><td>\0</td></tr>
      <tr><td><b>temp</b> llave correcta</td><td>"La c"</td><td>"ompu"</td><td>…</td><td>\0</td></tr>
      <tr><td><b>temp</b> llave 0 (incorrecta)</td><td>11 e8 e4 55</td><td>14 c7 54 25</td><td>…</td><td>\0</td></tr>
    </table>>];

  nota [shape=note, fillcolor="#f3f3f3", color="#777",
        label="DES no avisa si la llave es incorrecta: siempre devuelve bytes.\nPor eso se valida buscando una frase conocida en el resultado.\nSe copia a temp porque decrypt trabaja in place y ciph\nse vuelve a usar con la siguiente llave."];

  dec -> mem [style=dashed, color="#2e7d4f", constraint=false];
  fin -> nota [style=invis];
}
